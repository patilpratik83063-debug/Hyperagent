# ---------------------------------------------------------------------------
# Hyperclients — Lead Qualification Engine  (copy to .env and fill in)
# ---------------------------------------------------------------------------

# --- AI classification (GPT-4o, full model — never point this at gpt-4o-mini) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Database (Supabase / Postgres) ---
# URL like https://xxxx.supabase.co ; use the service-role key for server-side writes.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Discovery: Google SERP API (Serper.dev-style Google search wrapper) ---
# Free key at https://serper.dev (2,500 searches/month free — verify current
# terms at signup). Discovery queries Google with:
#    "<query> site:linkedin.com/posts after:YYYY-MM-DD"
# Known trade-offs (designed for, not bugs): Google crawls linkedin.com/posts
# partially and with a 1-3 day lag, so tight queries / the 24h window often
# return little or nothing — the engine reports that as a normal shortage.
DISCOVERY_PROVIDER=auto      # auto | serp | mock
MOCK_MODE=0                  # 1 = offline demo corpus (no keys needed)

SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
SERPER_SITE_RESTRICTION=linkedin.com/posts
SERPER_RESULTS_PER_QUERY=10   # Serper free tier caps num at 10 (HTTP 400 above)
# Optional Google country/language for ranking (gl=us, hl=en).
# SERPER_GL=
# SERPER_HL=en

# --- Search / usage budget ---
MAX_SEARCHES_PER_DAY=20

# --- Scoring gates (engine applies ALL of them — hard gates, not averages) ---
MIN_OVERALL_SCORE=60
MIN_SERVICE_MATCH=50
MIN_INTENT_STRENGTH=recommendation   # explicit | active_search | recommendation

# --- Engine loop (exact-count: loops until N leads or discovery runs dry) ---
ENGINE_MAX_ITERATIONS=30
ENGINE_DEADLINE_SECONDS=1800
ENGINE_EARLY_STOP_EMPTY_ROUNDS=3
CLASSIFIER_CONCURRENCY=8
